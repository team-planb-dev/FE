# 카카오맵 JavaScript 키. https://developers.kakao.com 에서 발급받고
# 플랫폼 > Web 에 실행할 도메인(http://localhost:5173)을 등록해야 지도가 뜹니다.
VITE_KAKAO_MAP_KEY=

# 백엔드 주소. 끝에 슬래시를 붙이지 않습니다.
# api-docs 의 servers 에는 http 로 적혀 있지만, 배포는 https 라서
# https 로 적어야 합니다. http 로 두면 브라우저가 mixed content 로 차단합니다.
VITE_API_BASE_URL=https://be-production-17fd.up.railway.app
